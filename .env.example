# Copy thành .env (đã gitignore). Mỗi dòng KEY=VALUE, không dấu nháy.
# Gói dữ liệu Track 1 và Track 2 (train giống hệt; pub_test đánh số khác). Bỏ SMOTP4SB_DATA_T2 nếu chỉ có một gói.
SMOTP4SB_DATA=E:\data\SMOTP4SB_T1
SMOTP4SB_DATA_T2=E:\data\SMOTP4SB_T2
SMOTP_WORK=E:\data\smotp_work
SMOTP_MODELS=E:\models

# Kaggle:  SMOTP4SB_DATA=/kaggle/input/<ten-dataset>   SMOTP_WORK=/kaggle/working
